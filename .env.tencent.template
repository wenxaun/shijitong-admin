# 腾讯云部署配置模板
# 复制此文件为 .env.tencent 并填写真实值

# ==================== 腾讯云镜像仓库配置 ====================
# 登录腾讯云控制台 -> 容器镜像服务 -> 查看命名空间
TENCENT_REGISTRY="ccr.ccs.tencentyun.com"
TENCENT_NAMESPACE=""  # 请填写你的命名空间（必填）

# ==================== 云开发配置 ====================
# 登录腾讯云控制台 -> 云开发 -> 环境详情 -> 查看环境ID
TCB_ENV_ID=""  # 请填写你的云开发环境ID（必填）

# ==================== API密钥配置 ====================
# 登录腾讯云控制台 -> 访问管理 -> API密钥管理
TENCENTCLOUD_SECRET_ID=""  # 请填写你的SecretId（必填）
TENCENTCLOUD_SECRET_KEY=""  # 请填写你的SecretKey（必填）

# ==================== 域名配置 ====================
# 后端API地址（部署后填写）
BACKEND_URL=""  # 如: https://api.yourdomain.com

# 管理后台域名（部署后填写）
ADMIN_URL=""  # 如: https://admin.yourdomain.com

# ==================== 安全配置 ====================
# JWT密钥（请使用随机字符串，建议32位以上）
JWT_SECRET=""  # 请填写随机密钥（必填）

# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ==================== 服务配置 ====================
# 后端服务端口（云托管通常使用80）
BACKEND_PORT=80

# Node.js环境
NODE_ENV=production

# ==================== 数据库配置 ====================
# 使用云开发数据库，无需额外配置
# 如果使用其他数据库，请在这里配置

# ==================== 邮件配置（可选）====================
# 如果需要邮件通知功能
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ==================== 其他配置 ====================
# 日志级别
LOG_LEVEL=info

# 时区
TZ=Asia/Shanghai

# ==================== 使用说明 ====================
# 1. 复制此文件: cp .env.tencent.template .env.tencent
# 2. 填写必填项: TENCENT_NAMESPACE, TCB_ENV_ID, SECRET_ID, SECRET_KEY, JWT_SECRET
# 3. 运行部署脚本: ./deploy-tencent-cloud.sh
# 4. 脚本会自动读取 .env.tencent 中的配置
