/* pages/org-create/org-create.wxss */
.container {
  padding: 40rpx;
  background: #f5f5f7;
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8E8E93;
}

/* 表单区域 */
.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1C1C1E;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #1C1C1E;
  line-height: 1.6;
}

/* 提示区域 */
.tips-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 16rpx;
}

.tips-content {
  font-size: 26rpx;
  color: #8E8E93;
  line-height: 1.8;
}

/* 操作区域 */
.action-section {
  padding: 20rpx;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #007AFF, #5AC8FA);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 32rpx;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0,122,255,0.3);
}
