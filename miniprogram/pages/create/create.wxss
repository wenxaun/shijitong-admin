/* pages/create/create.wxss - 飞书风格修复版 */

.page-container {
  min-height: 100vh;
  background: var(--fs-bg);
  padding: 0;
  display: flex;
  flex-direction: column;
}

/* 自定义导航栏（统一高度 120rpx） */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #1377EB;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 页面内容上边距（18px ≈ 68rpx） */
.page-container {
  padding-top: 68rpx;
}

/* 表单区块 */
.form-section {
  background: var(--fs-white);
  margin: var(--fs-spacing-page);
  border-radius: var(--fs-radius-card);
  padding: var(--fs-spacing-item);
  box-shadow: var(--fs-shadow-light);
  flex: 1;
}

.form-item {
  margin-bottom: var(--fs-spacing-item);
}

.form-item:last-child {
  margin-bottom: 0;
}

/* 表单标签（左对齐） */
.form-label-inline {
  display: flex;
  align-items: center;
  margin-bottom: var(--fs-spacing-small);
}

.form-label-inline .required {
  color: var(--fs-error);
  margin-right: 4rpx;
  font-size: var(--fs-font-small);
}

.form-label-inline .label-text {
  font-size: var(--fs-font-small);
  font-weight: var(--fs-weight-medium);
  color: var(--fs-text-sec);
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--fs-bg);
  border-radius: var(--fs-radius-btn);
  padding: 0 var(--fs-spacing-item);
  font-size: var(--fs-font-body);
  color: var(--fs-text-main);
  border: 2rpx solid transparent;
  transition: all var(--fs-transition);
  box-sizing: border-box;
}

.form-input:focus {
  background: var(--fs-white);
  border-color: var(--fs-blue);
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background: var(--fs-bg);
  border-radius: var(--fs-radius-btn);
  padding: var(--fs-spacing-small) var(--fs-spacing-item);
  font-size: var(--fs-font-body);
  color: var(--fs-text-main);
  border: 2rpx solid transparent;
  line-height: var(--fs-line-height);
  transition: all var(--fs-transition);
  box-sizing: border-box;
}

.form-textarea:focus {
  background: var(--fs-white);
  border-color: var(--fs-blue);
}

/* 优先级选择器 */
.priority-group {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--fs-spacing-small);
}

.priority-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--fs-spacing-small);
  background: var(--fs-bg);
  border-radius: var(--fs-radius-btn);
  border: 2rpx solid transparent;
  transition: all var(--fs-transition);
}

.priority-item:active {
  transform: scale(0.95);
}

.priority-item.active {
  border-color: currentColor;
}

.priority-item[data-priority="P0"].active {
  background: #FFECE8;
  color: var(--fs-error);
}

.priority-item[data-priority="P1"].active {
  background: #FFF3E6;
  color: var(--fs-warning);
}

.priority-item[data-priority="P2"].active {
  background: var(--fs-blue-light);
  color: var(--fs-blue);
}

.priority-item[data-priority="P3"].active {
  background: var(--fs-bg);
  color: var(--fs-text-aux);
}

.priority-label {
  font-size: var(--fs-font-body);
  font-weight: var(--fs-weight-semibold);
  margin-bottom: 4rpx;
}

.priority-desc {
  font-size: var(--fs-font-tiny);
  color: currentColor;
  opacity: 0.8;
}

/* 选择器 */
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 var(--fs-spacing-item);
  background: var(--fs-bg);
  border-radius: var(--fs-radius-btn);
  font-size: var(--fs-font-body);
  color: var(--fs-text-main);
}

.form-picker.placeholder {
  color: var(--fs-text-aux);
}

.picker-arrow {
  color: var(--fs-text-aux);
  font-size: var(--fs-font-body);
}

/* 提交按钮区块 */
.submit-section {
  padding: 0 var(--fs-spacing-page) var(--fs-spacing-card);
  position: sticky;
  bottom: 0;
  background: var(--fs-bg);
  z-index: 100;
}

.submit-btn {
  background: linear-gradient(135deg, var(--fs-blue), #2B85E4);
  color: var(--fs-white);
  height: 80rpx;
  font-size: var(--fs-font-body);
  font-weight: var(--fs-weight-semibold);
  border-radius: var(--fs-radius-btn);
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(19,119,235,0.3);
  transition: all var(--fs-transition);
}

.submit-btn:active {
  transform: scale(0.96);
  background: linear-gradient(135deg, var(--fs-blue-dark), #1E73D8);
  box-shadow: 0 2rpx 8rpx rgba(19,119,235,0.2);
}

/* 底部占位 */
.tabbar-placeholder {
  height: 100rpx;
}
