/* pages/exception/exception.wxss */
.task-info {
  text-align: center;
  padding: 30rpx 24rpx;
}

.task-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.task-date {
  font-size: 26rpx;
  color: #999;
}

.form-tip {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #fff7e6;
  border-left: 4rpx solid #faad14;
}

.form-tip.warning {
  background-color: #fff7e6;
  border-left-color: #faad14;
}

.tip-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #666;
}

.form-item {
  padding: 24rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  color: #333;
}

.required {
  color: #ff4d4f;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.radio-group {
  display: flex;
  gap: 16rpx;
}

.radio-item {
  flex: 1;
  padding: 16rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.radio-item.active {
  background-color: #07c160;
  color: white;
}

.form-picker {
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333;
}

.form-picker.placeholder {
  color: #999;
}

.submit-btn {
  background-color: #faad14;
  color: white;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin: 20rpx;
}

.submit-btn:active {
  background-color: #e69a0c;
}

.cancel-btn {
  background-color: #fff;
  color: #666;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin: 0 20rpx 40rpx;
  border: 1rpx solid #d9d9d9;
}

.cancel-btn:active {
  background-color: #f5f5f5;
}
