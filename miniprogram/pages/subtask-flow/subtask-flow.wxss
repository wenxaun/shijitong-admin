/* pages/subtask-flow/subtask-flow.wxss */
.container {
  padding: 24rpx;
  background-color: #F5F7FA;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 任务信息卡片 */
.task-info {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.info-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 表单区域 */
.form-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #FF4D4F;
  margin-right: 4rpx;
}

.form-picker,
.form-textarea {
  height: 80rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333333;
  border: 2rpx solid transparent;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-picker::after {
  content: '▼';
  font-size: 20rpx;
  color: #999999;
}

.form-picker.placeholder {
  color: #999999;
}

.form-textarea {
  height: 200rpx;
  padding: 24rpx;
  line-height: 1.6;
}

/* 流转历史 */
.flow-history {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.history-header {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #E5E6EB;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  padding: 16rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  border-left: 4rpx solid #1377EB;
}

.history-time {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.history-content {
  font-size: 26rpx;
  color: #333333;
}

.arrow {
  margin: 0 12rpx;
  color: #999999;
}

.history-reason {
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
}

/* 底部按钮 */
.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.submit-btn {
  height: 80rpx;
  background: #1377EB;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.submit-btn::after {
  border: none;
}
