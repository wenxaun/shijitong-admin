/* pages/splash/splash.wxss - v5.0.6 启动页 */

.splash-container {
  min-height: 100vh;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.splash-content {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.logo-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
  text-align: center;
}

.logo-subtitle {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 48rpx;
}

.loading-tip {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
}

/* 启动页按钮 */
.splash-buttons {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 48rpx;
}

.splash-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: 32rpx;
  font-weight: 500;
}

.splash-btn.primary {
  background: #1377EB;
  color: #FFFFFF;
}

.splash-btn.secondary {
  background: #F5F6F7;
  color: #333333;
}

.splash-btn:active {
  opacity: 0.8;
}
