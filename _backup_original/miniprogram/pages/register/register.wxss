/* pages/register/register.wxss - v5.0.2 飞书风格 */

.register-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1377EB 0%, #0D5FB8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}

.register-content {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
}

/* Logo 区域 */
.logo-section {
  text-align: center;
  margin-bottom: 48rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 16rpx;
}

.logo-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.logo-subtitle {
  font-size: 26rpx;
  color: #999999;
}

/* 注册表单 */
.register-form {
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #F5F6F7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.form-input:focus {
  background: #FFFFFF;
  border-color: #1377EB;
}

.selector-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  background: #F5F6F7;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.selector-text {
  font-size: 28rpx;
  color: #333333;
}

.selector-arrow {
  font-size: 32rpx;
  color: #999999;
}

.register-btn {
  background: #1377EB;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx 0;
  border-radius: 16rpx;
  border: none;
  margin-top: 32rpx;
  margin-bottom: 24rpx;
}

.register-btn:active {
  opacity: 0.9;
}

.btn-text {
  font-weight: 600;
}

.login-link {
  text-align: center;
  font-size: 26rpx;
  color: #999999;
}

.link-text {
  color: #1377EB;
  font-weight: 500;
  margin-left: 8rpx;
}
