/* pages/weekly/weekly.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f7;
  min-height: 100vh;
}

/* 日期选择器 */
.week-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.nav-btn {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  background: #007AFF;
  color: #fff;
  border-radius: 8rpx;
  border: none;
}

.week-range {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
}

/* 统计卡片 */
.stats-container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  background: #fff;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 8rpx;
}

.stat-value.high {
  color: #34C759;
}

.stat-value.low {
  color: #FF3B30;
}

.stat-label {
  font-size: 22rpx;
  color: #8E8E93;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 24rpx;
}

/* 归因列表 */
.attribution-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.attribution-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.attribution-name {
  width: 160rpx;
  font-size: 26rpx;
  color: #1C1C1E;
  font-weight: 500;
}

.attribution-bar {
  flex: 1;
  height: 16rpx;
  background: #E5E5EA;
  border-radius: 8rpx;
  overflow: hidden;
}

.attribution-fill {
  height: 100%;
  background: linear-gradient(90deg, #007AFF, #5AC8FA);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.attribution-count {
  width: 140rpx;
  font-size: 24rpx;
  color: #8E8E93;
  text-align: right;
}

/* 任务列表 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  padding: 24rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  border-left: 6rpx solid #007AFF;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.task-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
  flex: 1;
}

.task-score {
  font-size: 28rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.task-score.score-high {
  background: #34C759;
  color: #fff;
}

.task-score.score-normal {
  background: #007AFF;
  color: #fff;
}

.task-score.score-low {
  background: #FF3B30;
  color: #fff;
}

.task-meta {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.task-priority {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-weight: 600;
}

.task-priority.priority-P0 {
  background: #FF3B30;
  color: #fff;
}

.task-priority.priority-P1 {
  background: #FF9500;
  color: #fff;
}

.task-priority.priority-P2 {
  background: #007AFF;
  color: #fff;
}

.task-priority.priority-P3 {
  background: #8E8E93;
  color: #fff;
}

.task-date {
  font-size: 22rpx;
  color: #8E8E93;
}

.task-score-note {
  font-size: 24rpx;
  color: #8E8E93;
  padding-top: 12rpx;
  border-top: 1rpx solid #E5E5EA;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #8E8E93;
  font-size: 28rpx;
}

/* 操作区 */
.action-section {
  padding: 20rpx;
}

.generate-btn {
  width: 100%;
  background: linear-gradient(135deg, #007AFF, #5AC8FA);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0,122,255,0.3);
}
