/* pages/index/index.wxss - 飞书风格重构 */

/* 自定义导航栏（统一高度 120rpx） */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #1377EB;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 页面内容上边距（18px ≈ 68rpx） */
.page-container {
  padding-top: 68rpx;
}

/* 筛选栏 */
.filter-section {
  margin: 0 var(--fs-spacing-page) var(--fs-spacing-card);
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--fs-spacing-small);
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-label {
  flex-shrink: 0;
  font-size: var(--fs-font-small);
  font-weight: var(--fs-weight-medium);
  color: var(--fs-text-sec);
  margin-right: var(--fs-spacing-small);
  white-space: nowrap;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.filter-scroll::-webkit-scrollbar {
  display: none;
}

.filter-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 var(--fs-spacing-small);
  margin-right: var(--fs-spacing-small);
  background: var(--fs-white);
  border-radius: var(--fs-radius-tag);
  font-size: var(--fs-font-small);
  font-weight: var(--fs-weight-medium);
  color: var(--fs-text-sec);
  border: 2rpx solid var(--fs-border);
  transition: all var(--fs-transition);
  flex-shrink: 0;
  white-space: nowrap;
}

.filter-btn:last-child {
  margin-right: 0;
}

.filter-btn:active {
  transform: scale(0.95);
}

.filter-btn.active {
  background: var(--fs-blue);
  border-color: var(--fs-blue);
  color: var(--fs-white);
}

/* 列表容器 */
.list-container {
  padding: 0 var(--fs-spacing-page) var(--fs-spacing-card);
}

/* 任务卡片 */
.task-card {
  margin-bottom: var(--fs-spacing-small);
  padding: 0;
  overflow: hidden;
  transition: all var(--fs-transition);
}

.task-card:active {
  transform: scale(0.98);
  box-shadow: var(--fs-shadow-card);
}

.task-card-inner {
  display: flex;
  padding: var(--fs-spacing-item);
}

/* 左侧状态条 */
.task-status-bar {
  width: 8rpx;
  flex-shrink: 0;
  border-radius: 4rpx;
  margin-right: var(--fs-spacing-small);
}

.task-status-bar.status-pending {
  background: var(--fs-blue);
}

.task-status-bar.status-in_progress {
  background: var(--fs-warning);
}

.task-status-bar.status-completed {
  background: var(--fs-success);
}

.task-status-bar.status-cancelled {
  background: var(--fs-text-aux);
}

/* 任务内容 */
.task-content {
  flex: 1;
  min-width: 0;
}

.task-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: var(--fs-spacing-small);
}

.task-name {
  flex: 1;
  font-size: var(--fs-font-body);
  line-height: var(--fs-line-height);
  margin-right: var(--fs-spacing-small);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 任务元信息 */
.task-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--fs-spacing-small);
  margin-bottom: var(--fs-spacing-small);
}

.task-status {
  font-size: var(--fs-font-tiny);
  padding: 4rpx 12rpx;
}

.tag-status-pending {
  background: var(--fs-blue-light);
  color: var(--fs-blue);
}

.tag-status-in_progress {
  background: #FFF3E6;
  color: var(--fs-warning);
}

.tag-status-completed {
  background: #E6F7EF;
  color: var(--fs-success);
}

.tag-status-cancelled {
  background: var(--fs-bg);
  color: var(--fs-text-aux);
}

.task-date {
  font-size: var(--fs-font-tiny);
}

/* 执行人信息 */
.task-executor {
  display: flex;
  align-items: center;
  font-size: var(--fs-font-small);
  margin-bottom: var(--fs-spacing-small);
}

.task-executor .icon {
  margin-right: 8rpx;
  font-size: var(--fs-font-small);
}

/* 进度条（有子任务时显示） */
.task-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--fs-spacing-small);
}

.progress-bar-mini {
  flex: 1;
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill-mini {
  height: 100%;
  background: linear-gradient(90deg, #1377EB, #4D9BFF);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-text-mini {
  font-size: 22rpx;
  color: #999999;
  width: 50rpx;
  text-align: right;
}

/* 任务底部 */
.task-footer {
  display: flex;
  align-items: center;
  padding-top: var(--fs-spacing-small);
  border-top: 2rpx solid var(--fs-divider);
  gap: var(--fs-spacing-small);
}

.task-score {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: var(--fs-radius-tag);
  font-size: var(--fs-font-tiny);
  font-weight: var(--fs-weight-semibold);
}

.task-score.score-high {
  background: #E6F7EF;
  color: var(--fs-success);
}

.task-score.score-normal {
  background: var(--fs-blue-light);
  color: var(--fs-blue);
}

.task-score.score-low {
  background: #FFECE8;
  color: var(--fs-error);
}

.task-score-note {
  font-size: var(--fs-font-tiny);
  flex: 1;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: var(--fs-spacing-item) 0;
  color: var(--fs-blue);
  font-size: var(--fs-font-small);
  font-weight: var(--fs-weight-medium);
}

.load-more:active {
  opacity: 0.7;
}

/* 底部占位 */
.tabbar-placeholder {
  height: 100rpx;
}
