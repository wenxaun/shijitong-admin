/* pages/login/login.wxss - v5.0.6 统一风格 */

.login-container {
  min-height: 100vh;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.login-content {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Logo 区域 */
.logo-section {
  text-align: center;
  margin-bottom: 96rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.logo-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
  text-align: center;
}

.logo-subtitle {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
}

/* 登录说明 */
.login-tip {
  width: 100%;
  text-align: center;
  margin-bottom: 48rpx;
  padding: 24rpx 32rpx;
  background: #F5F6F7;
  border-radius: 16rpx;
}

.tip-text {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.tip-hint {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

/* 按钮区域 */
.button-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.login-button {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  font-size: 32rpx;
  font-weight: 500;
}

.login-button.primary {
  background: #1377EB;
  color: #FFFFFF;
}

.login-button.secondary {
  background: #F5F6F7;
  color: #333333;
}

.login-button:active {
  opacity: 0.8;
}

.button-text {
  font-weight: 500;
}

/* 底部说明 */
.footer-section {
  width: 100%;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.8;
  text-align: center;
}

.link {
  color: #1377EB;
  text-decoration: underline;
}
