/* pages/stats/stats.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f7;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

/* 范围选择器 */
.range-selector {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
}

.range-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #E5E5EA;
  color: #8E8E93;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.range-btn.active {
  background: #007AFF;
  color: #fff;
}

/* 指标网格 */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.metric-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.metric-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.metric-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-bottom: 8rpx;
}

.metric-label {
  font-size: 24rpx;
  color: #8E8E93;
}

/* 图表区块 */
.chart-section {
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 24rpx;
}

/* 分数分布 */
.score-distribution {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.score-bar-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.score-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #1C1C1E;
}

.score-bar-container {
  flex: 1;
  height: 20rpx;
  background: #E5E5EA;
  border-radius: 10rpx;
  overflow: hidden;
}

.score-bar {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

.score-count {
  width: 100rpx;
  font-size: 24rpx;
  color: #8E8E93;
  text-align: right;
}

/* 优先级分布 */
.priority-chart {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.priority-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.priority-label {
  width: 80rpx;
  text-align: center;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

.priority-label.priority-P0 {
  background: #FF3B30;
}

.priority-label.priority-P1 {
  background: #FF9500;
}

.priority-label.priority-P2 {
  background: #007AFF;
}

.priority-label.priority-P3 {
  background: #8E8E93;
}

.priority-bar-container {
  flex: 1;
  height: 20rpx;
  background: #E5E5EA;
  border-radius: 10rpx;
  overflow: hidden;
}

.priority-bar {
  height: 100%;
  background: linear-gradient(90deg, #007AFF, #5AC8FA);
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

.priority-count {
  width: 180rpx;
  font-size: 24rpx;
  color: #8E8E93;
  text-align: right;
}

/* 分类统计 */
.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
}

.category-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1C1C1E;
  flex: 1;
}

.category-count {
  font-size: 24rpx;
  color: #8E8E93;
  margin: 0 20rpx;
}

.category-score {
  font-size: 24rpx;
  color: #007AFF;
  font-weight: 600;
}

/* 趋势图 */
.trend-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding: 20rpx 0;
}

.trend-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.trend-date {
  font-size: 20rpx;
  color: #8E8E93;
  margin-bottom: 8rpx;
}

.trend-bar-container {
  width: 40rpx;
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.trend-bar {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.3s ease;
}

.trend-count {
  font-size: 22rpx;
  color: #1C1C1E;
  font-weight: 600;
  margin-top: 8rpx;
}

/* 刷新按钮 */
.refresh-section {
  padding: 20rpx;
}

.refresh-btn {
  width: 100%;
  background: linear-gradient(135deg, #007AFF, #5AC8FA);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 28rpx;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0,122,255,0.3);
}
