/* pages/edit/edit.wxss */
.form {
  padding: 20rpx;
}

.form-item {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  color: #333;
}

.required {
  color: #ff4d4f;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-textarea {
  min-height: 200rpx;
}

.form-picker {
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333;
}

.form-picker.placeholder {
  color: #999;
}

.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-item {
  flex: 1;
  min-width: 120rpx;
  padding: 16rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.radio-item.active {
  background-color: #07c160;
  color: white;
}

.submit-btn {
  background-color: #07c160;
  color: white;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
}

.submit-btn:active {
  background-color: #06ad56;
}

/* 复盘区域 */
.review-section {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.tag-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  font-size: 24rpx;
  color: #666;
}

.tag-item.active {
  background: #1377EB;
  color: #fff;
}
