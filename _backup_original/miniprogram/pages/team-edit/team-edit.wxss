/* pages/team-edit/team-edit.wxss */
.form {
  padding: 20rpx;
}

.form-item {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  color: #333;
}

.form-input,
.form-picker {
  width: 100%;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.form-picker {
  color: #333;
}

.form-picker.placeholder {
  color: #999;
}

.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-item {
  flex: 1;
  min-width: 120rpx;
  padding: 16rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.radio-item.active {
  background-color: #07c160;
  color: white;
}

.role-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.checkbox-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.checkbox-icon {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 4rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: transparent;
}

.checkbox-icon.checked {
  background-color: #07c160;
  border-color: #07c160;
  color: white;
}

.submit-btn {
  background-color: #07c160;
  color: white;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
}

.submit-btn:active {
  background-color: #06ad56;
}
