/* pages/subtask-manage/subtask-manage.wxss - v5.0.0 */

.page-container {
  min-height: 100vh;
  background: #F5F6F7;
  padding: 24rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-text {
  color: #999999;
  font-size: 28rpx;
}

/* 待办状态提示 */
.pending-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 48rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #999999;
}

/* 进度卡片 */
.progress-card {
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  margin-bottom: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.progress-count {
  font-size: 24rpx;
  color: #999999;
}

.progress-bar {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1377EB, #4D9BFF);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-footer {
  text-align: right;
}

.progress-percent {
  font-size: 24rpx;
  color: #999999;
}

/* 添加按钮 */
.add-subtask-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #1377EB;
  margin-bottom: 24rpx;
}

.add-icon {
  font-size: 32rpx;
  color: #1377EB;
  font-weight: bold;
}

.add-text {
  font-size: 28rpx;
  color: #1377EB;
}

/* 子任务列表 */
.subtask-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999999;
}

.subtask-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-status {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.card-status.pending { background: #FF8800; }
.card-status.in_progress { background: #1377EB; }
.card-status.completed { background: #00B365; }
.card-status.cancelled { background: #999999; }

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.card-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999999;
}

.meta-item.overdue {
  color: #FF5252;
  font-weight: 500;
}

.card-arrow {
  font-size: 36rpx;
  color: #999999;
}
